{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "asociacion mutual el rosario",
  "version": "0.1.0",
  "identifier": "com.asociacionmutual.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "ASOCIACION MUTUAL EL ROSARIO LIBORINA",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/mutual.sqlite"],
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-512.png",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQzhEQ0VERTAyRDJFQ0IKUldUTExpM2c3ZHpJcmdCYnV1anNxQkFKK25PU3NuYU1RaDlPZk94RW1SSzJnbTlHeDVRVWxLMjkK",
      "endpoints": [
        "https://github.com/programarum/asociacion_mutual/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
